# Required
MAC_MINI_IP=192.168.0.104
K3S_NODE_IP=192.168.0.121
STF_SECRET=nosecret
IOS_PROVIDER_NAME=ios-provider

# Optional
# Default: ws://${MAC_MINI_IP}:<%= publicPort %>
IOS_SCREEN_WS_URL_PATTERN=ws://192.168.0.104:<%= publicPort %>

# Optional port ranges
IOS_PORT_RANGE_MIN=8100
IOS_PORT_RANGE_MAX=8200
IOS_SCREEN_WS_RANGE_MIN=18000
IOS_SCREEN_WS_RANGE_MAX=18100
IOS_WDA_RANGE_MIN=18200
IOS_WDA_RANGE_MAX=18300

# Optional UDID allow-list (comma-separated). Leave empty to include all connected iOS devices.
# IOS_SERIALS=00008110-001A2D123456801E,00008120-000D3E123456802F
