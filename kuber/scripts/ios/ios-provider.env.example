# Required
MAC_MINI_IP=192.168.0.104
K3S_NODE_IP=192.168.0.121
STF_SECRET=nosecret
IOS_PROVIDER_NAME=ios-provider

# Optional
# Public host advertised by provider in generated device URLs.
# Use domain when DeviceHub is opened via HTTPS in browser.
IOS_PROVIDER_PUBLIC_HOST=devicehub.putmyhexon.ru

# Default: ws://${IOS_PROVIDER_PUBLIC_HOST}:<%= publicPort %>
# Recommended for HTTPS DeviceHub:
IOS_SCREEN_WS_URL_PATTERN="wss://devicehub.putmyhexon.ru/d/ios-provider/<%= publicPort %>/"

# Optional. Useful when WDA/connect endpoint should also go via ingress.
# IOS_CONNECT_URL_PATTERN="https://devicehub.putmyhexon.ru/d/ios-provider/<%= publicPort %>/"

# Required for iOS provider/device processes to reach Mongo in k8s.
MONGODB_PORT_27017_TCP="mongodb://192.168.0.123:32017/?directConnection=true"

# Optional port ranges
IOS_PORT_RANGE_MIN=8100
IOS_PORT_RANGE_MAX=8101
IOS_SCREEN_WS_RANGE_MIN=18000
IOS_SCREEN_WS_RANGE_MAX=18001
IOS_WDA_RANGE_MIN=18200
IOS_WDA_RANGE_MAX=18201

# Optional UDID allow-list (comma-separated). Leave empty to include all connected iOS devices.
IOS_SERIALS=00008110-000625A02146201E
